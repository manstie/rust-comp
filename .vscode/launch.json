{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug rust-comp (with input)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=rust-comp"
                ]
            },
            "program": "${workspaceFolder}/target/debug/rust-comp",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stdio": [
                "${workspaceFolder}/test/1.in",
                null,
                null
            ]
        }
    ]
}
